<?xml version="1.0"?>
<!-- The cell tool on tool0: tool changer, the gripper (a model from ros/urdf/grippers/, chosen by gripper.model in
     config/cell.yaml or env UR_GRIPPER), wrist camera + bracket, and the TCP link. Sizes come from
     config/cell.yaml (section "tool"); values marked MEASURE there are estimates.
     Frames (tool0 = UR flange): z points out of the flange towards the fingers, the fingers close along x.
     The gripper's driving joint is not a ros2_control joint: ros/scripts/finger_state_publisher.py publishes it
     from the width, through the model's table (config/grippers/<model>.yaml). -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="cell_box" params="name size xyz rpy rgba">
    <link name="${name}">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><box size="${size}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="cell_tool" params="tf_prefix cell gripper grippers_dir">
    <xacro:property name="t" value="${cell['tool']}"/>
    <xacro:property name="model" value="${gripper if gripper else cell['gripper']['model']}"/>
    <xacro:property name="gm" value="${xacro.load_yaml(grippers_dir + '/' + model + '.yaml')}"/>
    <xacro:property name="L" value="${t['changer_length_m']}"/>
    <!-- table rows run open -> closed: the last row is the closed gripper -->
    <xacro:property name="tcp" value="${L + gm['mount_offset_m'] + gm['table'][-1][2]}"/>
    <xacro:property name="yaw" value="${0.0 if gm['closing_axis_in_mount'] == t['finger_axis'] else pi / 2}"/>

    <!-- flange plate + tool changer -->
    <link name="${tf_prefix}tool_changer">
      <visual>
        <origin xyz="0 0 ${L / 2}"/>
        <geometry><cylinder radius="${t['changer_radius_m']}" length="${L}"/></geometry>
        <material name="changer_mat"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${L / 2}"/>
        <geometry><cylinder radius="${t['changer_radius_m']}" length="${L}"/></geometry>
      </collision>
    </link>
    <joint name="${tf_prefix}tool0-tool_changer" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}tool_changer"/>
    </joint>

    <!-- the gripper on the changer -->
    <xacro:if value="${model == 'rg6'}">
      <xacro:include filename="grippers/rg6.xacro"/>
      <xacro:gripper_rg6 tf_prefix="${tf_prefix}" parent="tool0" z="${L + gm['mount_offset_m']}" yaw="${yaw}"/>
    </xacro:if>
    <xacro:if value="${model == 'robotiq_2f85'}">
      <xacro:include filename="grippers/robotiq_2f85.xacro"/>
      <xacro:gripper_robotiq_2f85 tf_prefix="${tf_prefix}" parent="tool0" z="${L + gm['mount_offset_m']}" yaw="${yaw}"/>
    </xacro:if>

    <!-- TCP: fingertip centre with the gripper closed -->
    <link name="${tf_prefix}tcp"/>
    <joint name="${tf_prefix}tool0-tcp" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}tcp"/>
      <origin xyz="0 0 ${tcp}" rpy="0 0 0"/>
    </joint>

    <!-- wrist camera at its hand-eye pose (camera optical frame: x right, y down, z forward) -->
    <xacro:property name="cxyz" value="${t['camera_xyz_m']}"/>
    <xacro:property name="crpy" value="${t['camera_rpy_rad']}"/>
    <xacro:property name="cb" value="${t['camera_box_m']}"/>
    <xacro:property name="cc" value="${t['camera_box_center_m']}"/>
    <xacro:cell_box name="${tf_prefix}wrist_camera" size="${cb[0]} ${cb[1]} ${cb[2]}" xyz="${cc[0]} ${cc[1]} ${cc[2]}"
                    rpy="0 0 0" rgba="0.1 0.1 0.1 1"/>
    <joint name="${tf_prefix}tool0-wrist_camera" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}wrist_camera"/>
      <origin xyz="${cxyz[0]} ${cxyz[1]} ${cxyz[2]}" rpy="${crpy[0]} ${crpy[1]} ${crpy[2]}"/>
    </joint>
    <xacro:property name="bs" value="${t['bracket_size_m']}"/>
    <xacro:property name="bx" value="${t['bracket_xyz_m']}"/>
    <xacro:property name="br" value="${t['bracket_rpy_rad']}"/>
    <xacro:cell_box name="${tf_prefix}camera_bracket" size="${bs[0]} ${bs[1]} ${bs[2]}" xyz="0 0 0" rpy="0 0 0"
                    rgba="0.3 0.3 0.35 1"/>
    <joint name="${tf_prefix}tool0-camera_bracket" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}camera_bracket"/>
      <origin xyz="${bx[0]} ${bx[1]} ${bx[2]}" rpy="${br[0]} ${br[1]} ${br[2]}"/>
    </joint>
  </xacro:macro>
</robot>
