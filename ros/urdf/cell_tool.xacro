<?xml version="1.0"?>
<!-- The cell tool on tool0: tool changer, the gripper (a model from ros/urdf/grippers/, chosen by gripper.model in
     config/cell.yaml or env UR_GRIPPER), wrist camera + bracket, and the TCP link. Sizes come from
     config/cell.yaml (section "tool"); values marked MEASURE there are estimates.
     Frames (tool0 = UR flange): z points out of the flange towards the fingers, the fingers close along x.
     The gripper's driving joint is not a ros2_control joint: ros/scripts/finger_state_publisher.py publishes it
     from the width, through the model's table (config/grippers/<model>.yaml). -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="cell_box" params="name size xyz rpy rgba">
    <link name="${name}">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><box size="${size}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="cell_tool" params="tf_prefix cell gripper grippers_dir tcp:='' camera_mount:=''">
    <xacro:property name="t" value="${cell['tool']}"/>
    <xacro:property name="model" value="${gripper if gripper else cell['gripper']['model']}"/>
    <xacro:property name="gm" value="${xacro.load_yaml(grippers_dir + '/' + model + '.yaml')}"/>
    <xacro:property name="L" value="${t['changer_length_m']}"/>
    <!-- the TCP read from the controller (x y z roll pitch yaw), when cell.launch.py passed one -->
    <xacro:property name="ptcp" value="${[float(v) for v in str(tcp).split()]}"/>
    <!-- otherwise: table rows run open -> closed, the last row is the closed gripper -->
    <xacro:property name="tcp_z" value="${ptcp[2] if ptcp else L + gm['mount_offset_m'] + gm['table'][-1][2]}"/>
    <!-- off-axis TCP (the gripper shifts with it): from the controller, else the model's calibrated value -->
    <xacro:property name="txy" value="${ptcp[0:2] if ptcp else gm.get('tcp_xy_m', [0.0, 0.0])}"/>
    <xacro:property name="trpy" value="${ptcp[3:6] if ptcp else [0.0, 0.0, 0.0]}"/>
    <!-- (2026-11-21, the operator's ground truth) the gripper is mounted PARALLEL TO THE CAMERA: with closing_along_camera_x the
         fingers close along the camera's x (its long side), the direction of the hand-eye camera mount (camera_mount when saved,
         else cell.yaml camera_rpy_rad), seen along tool0 z; mount_yaw_rad is then an extra turn on top. The camera is placed by the
         calibration and matches the cell; the gripper had a hand-set turn (-0.508, then 0) that did not. Not the pendant TCP x:
         that one is turned against the camera on the real robot -->
    <xacro:property name="pcm0" value="${[float(v) for v in str(camera_mount).split()]}"/>
    <xacro:property name="crpy0" value="${pcm0[3:6] if pcm0 else t['camera_rpy_rad']}"/>
    <xacro:property name="cam_yaw" value="${atan2(sin(crpy0[2]) * cos(crpy0[1]), cos(crpy0[2]) * cos(crpy0[1]))}"/>
    <xacro:property name="yaw" value="${(0.0 if gm['closing_axis_in_mount'] == t['finger_axis'] else pi / 2)
                                         + (cam_yaw if gm.get('closing_along_camera_x', False) else 0.0) + gm.get('mount_yaw_rad', 0.0)}"/>

    <!-- flange plate + tool changer -->
    <link name="${tf_prefix}tool_changer">
      <visual>
        <origin xyz="0 0 ${L / 2}"/>
        <geometry><cylinder radius="${t['changer_radius_m']}" length="${L}"/></geometry>
        <material name="changer_mat"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${L / 2}"/>
        <geometry><cylinder radius="${t['changer_radius_m']}" length="${L}"/></geometry>
      </collision>
    </link>
    <joint name="${tf_prefix}tool0-tool_changer" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}tool_changer"/>
    </joint>

    <!-- the gripper on the changer -->
    <xacro:if value="${model == 'rg6'}">
      <xacro:include filename="grippers/rg6.xacro"/>
      <xacro:gripper_rg6 tf_prefix="${tf_prefix}" parent="tool0" x="${txy[0]}" y="${txy[1]}" z="${L + gm['mount_offset_m']}" yaw="${yaw}"/>
    </xacro:if>
    <xacro:if value="${model == 'robotiq_2f85'}">
      <xacro:include filename="grippers/robotiq_2f85.xacro"/>
      <xacro:gripper_robotiq_2f85 tf_prefix="${tf_prefix}" parent="tool0" z="${L + gm['mount_offset_m']}" yaw="${yaw}"/>
    </xacro:if>

    <!-- (2026-11-21) box colliders of the gripper (gm collider_boxes): one link gripper_collider_<name> per box, fixed to the
         box's link (default the hand link), collision only, so the gripper's own mesh stays what you see. Boxes on the
         moving finger links open and close with the width of every check. RViz draws them as boxes (routes_viz) -->
    <xacro:macro name="collider_links" params="boxes">
      <xacro:if value="${len(boxes) > 0}">
        <xacro:property name="cb0" value="${boxes[0]}"/>
        <link name="${tf_prefix}gripper_collider_${cb0['name']}">
          <collision>
            <xacro:property name="cr0" value="${cb0.get('rpy', [0.0, 0.0, 0.0])}"/>
            <origin xyz="${cb0['center'][0]} ${cb0['center'][1]} ${cb0['center'][2]}" rpy="${cr0[0]} ${cr0[1]} ${cr0[2]}"/>
            <geometry><box size="${cb0['size'][0]} ${cb0['size'][1]} ${cb0['size'][2]}"/></geometry>
          </collision>
        </link>
        <joint name="${tf_prefix}gripper_collider_${cb0['name']}_joint" type="fixed">
          <parent link="${tf_prefix}${cb0.get('link', gm['hand_link'])}"/>
          <child link="${tf_prefix}gripper_collider_${cb0['name']}"/>
        </joint>
        <xacro:collider_links boxes="${boxes[1:]}"/>
      </xacro:if>
    </xacro:macro>
    <xacro:collider_links boxes="${gm.get('collider_boxes', [])}"/>

    <!-- TCP: fingertip centre with the gripper closed -->
    <link name="${tf_prefix}tcp"/>
    <joint name="${tf_prefix}tool0-tcp" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}tcp"/>
      <origin xyz="${txy[0]} ${txy[1]} ${tcp_z}" rpy="${trpy[0]} ${trpy[1]} ${trpy[2]}"/>
    </joint>

    <!-- wrist camera at its hand-eye pose (camera optical frame: x right, y down, z forward) -->
    <!-- (2026-11-20) the saved hand-eye (camera_mount, 15 numbers) wins over cell.yaml's: camera xyz rpy, bracket xyz rpy size -->
    <xacro:property name="pcm" value="${[float(v) for v in str(camera_mount).split()]}"/>
    <xacro:property name="cxyz" value="${pcm[0:3] if pcm else t['camera_xyz_m']}"/>
    <xacro:property name="crpy" value="${pcm[3:6] if pcm else t['camera_rpy_rad']}"/>
    <xacro:property name="cb" value="${t['camera_box_m']}"/>
    <xacro:property name="cc" value="${t['camera_box_center_m']}"/>
    <xacro:cell_box name="${tf_prefix}wrist_camera" size="${cb[0]} ${cb[1]} ${cb[2]}" xyz="${cc[0]} ${cc[1]} ${cc[2]}"
                    rpy="0 0 0" rgba="0.1 0.1 0.1 1"/>
    <joint name="${tf_prefix}tool0-wrist_camera" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}wrist_camera"/>
      <origin xyz="${cxyz[0]} ${cxyz[1]} ${cxyz[2]}" rpy="${crpy[0]} ${crpy[1]} ${crpy[2]}"/>
    </joint>
    <xacro:property name="bs" value="${pcm[12:15] if pcm else t['bracket_size_m']}"/>
    <xacro:property name="bx" value="${pcm[6:9] if pcm else t['bracket_xyz_m']}"/>
    <xacro:property name="br" value="${pcm[9:12] if pcm else t['bracket_rpy_rad']}"/>
    <xacro:cell_box name="${tf_prefix}camera_bracket" size="${bs[0]} ${bs[1]} ${bs[2]}" xyz="0 0 0" rpy="0 0 0"
                    rgba="0.3 0.3 0.35 1"/>
    <joint name="${tf_prefix}tool0-camera_bracket" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}camera_bracket"/>
      <origin xyz="${bx[0]} ${bx[1]} ${bx[2]}" rpy="${br[0]} ${br[1]} ${br[2]}"/>
    </joint>
  </xacro:macro>
</robot>
