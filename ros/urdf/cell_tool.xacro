<?xml version="1.0"?>
<!-- The cell tool on tool0: tool changer, OnRobot RG6 housing + two fingers, wrist camera + bracket, and the
     TCP link. All sizes come from config/cell.yaml (section "tool"); values marked MEASURE there are estimates.
     Frames (tool0 = UR flange): z points out of the flange towards the fingers, the fingers close along x.
     rg6_finger_joint is the opening of ONE finger (half the gripper width, 0 .. max_width/2); the right
     finger mimics it. It is not a ros2_control joint: ros/scripts/finger_state_publisher.py publishes it. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="cell_box" params="name size xyz rpy rgba">
    <link name="${name}">
      <visual>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><box size="${size}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="cell_tool" params="tf_prefix cell">
    <xacro:property name="t" value="${cell['tool']}"/>
    <xacro:property name="g" value="${cell['gripper']}"/>
    <xacro:property name="L" value="${t['changer_length_m']}"/>
    <xacro:property name="B" value="${t['body_size_m']}"/>
    <xacro:property name="F" value="${t['finger_size_m']}"/>
    <xacro:property name="tcp" value="${t['tcp_z_m']}"/>
    <xacro:property name="ax" value="${'1 0 0' if t['finger_axis'] == 'x' else '0 1 0'}"/>
    <xacro:property name="yaw" value="${0.0 if t['finger_axis'] == 'x' else pi / 2}"/>

    <!-- flange plate + tool changer -->
    <link name="${tf_prefix}tool_changer">
      <visual>
        <origin xyz="0 0 ${L / 2}"/>
        <geometry><cylinder radius="${t['changer_radius_m']}" length="${L}"/></geometry>
        <material name="changer_mat"><color rgba="0.6 0.6 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${L / 2}"/>
        <geometry><cylinder radius="${t['changer_radius_m']}" length="${L}"/></geometry>
      </collision>
    </link>
    <joint name="${tf_prefix}tool0-tool_changer" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}tool_changer"/>
    </joint>

    <!-- RG6 housing (its x side along the finger motion) -->
    <xacro:cell_box name="${tf_prefix}rg6_body" size="${B[0]} ${B[1]} ${B[2]}" xyz="0 0 ${L + B[2] / 2}"
                    rpy="0 0 ${yaw}" rgba="0.2 0.2 0.2 1"/>
    <joint name="${tf_prefix}tool0-rg6_body" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}rg6_body"/>
    </joint>

    <!-- fingers: each a box whose inner (grasping) face sits at the joint position -->
    <xacro:cell_box name="${tf_prefix}rg6_left_finger" size="${F[0]} ${F[1]} ${F[2]}"
                    xyz="${F[0] / 2} 0 0" rpy="0 0 0" rgba="0.75 0.75 0.75 1"/>
    <joint name="${tf_prefix}rg6_finger_joint" type="prismatic">
      <parent link="${tf_prefix}rg6_body"/>
      <child link="${tf_prefix}rg6_left_finger"/>
      <origin xyz="0 0 ${tcp - F[2] / 2}" rpy="0 0 ${yaw}"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="${g['max_width_m'] / 2}" effort="200" velocity="0.2"/>
    </joint>
    <xacro:cell_box name="${tf_prefix}rg6_right_finger" size="${F[0]} ${F[1]} ${F[2]}"
                    xyz="${-F[0] / 2} 0 0" rpy="0 0 0" rgba="0.75 0.75 0.75 1"/>
    <joint name="${tf_prefix}rg6_right_finger_joint" type="prismatic">
      <parent link="${tf_prefix}rg6_body"/>
      <child link="${tf_prefix}rg6_right_finger"/>
      <origin xyz="0 0 ${tcp - F[2] / 2}" rpy="0 0 ${yaw}"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0.0" upper="${g['max_width_m'] / 2}" effort="200" velocity="0.2"/>
      <mimic joint="${tf_prefix}rg6_finger_joint" multiplier="1" offset="0"/>
    </joint>

    <!-- TCP: fingertip centre with the gripper closed -->
    <link name="${tf_prefix}tcp"/>
    <joint name="${tf_prefix}tool0-tcp" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}tcp"/>
      <origin xyz="0 0 ${tcp}" rpy="0 0 0"/>
    </joint>

    <!-- wrist camera at its hand-eye pose (camera optical frame: x right, y down, z forward) -->
    <xacro:property name="cxyz" value="${t['camera_xyz_m']}"/>
    <xacro:property name="crpy" value="${t['camera_rpy_rad']}"/>
    <xacro:property name="cb" value="${t['camera_box_m']}"/>
    <xacro:property name="cc" value="${t['camera_box_center_m']}"/>
    <xacro:cell_box name="${tf_prefix}wrist_camera" size="${cb[0]} ${cb[1]} ${cb[2]}" xyz="${cc[0]} ${cc[1]} ${cc[2]}"
                    rpy="0 0 0" rgba="0.1 0.1 0.1 1"/>
    <joint name="${tf_prefix}tool0-wrist_camera" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}wrist_camera"/>
      <origin xyz="${cxyz[0]} ${cxyz[1]} ${cxyz[2]}" rpy="${crpy[0]} ${crpy[1]} ${crpy[2]}"/>
    </joint>
    <xacro:property name="bs" value="${t['bracket_size_m']}"/>
    <xacro:property name="bx" value="${t['bracket_xyz_m']}"/>
    <xacro:property name="br" value="${t['bracket_rpy_rad']}"/>
    <xacro:cell_box name="${tf_prefix}camera_bracket" size="${bs[0]} ${bs[1]} ${bs[2]}" xyz="0 0 0" rpy="0 0 0"
                    rgba="0.3 0.3 0.35 1"/>
    <joint name="${tf_prefix}tool0-camera_bracket" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}camera_bracket"/>
      <origin xyz="${bx[0]} ${bx[1]} ${bx[2]}" rpy="${br[0]} ${br[1]} ${br[2]}"/>
    </joint>
  </xacro:macro>
</robot>
